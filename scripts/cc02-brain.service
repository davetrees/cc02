[Unit]
Description=CC-02 RC car brain (camera, YOLO, serial link, web panel)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/cc02/brain
ExecStart=/home/pi/cc02/venv/bin/python /home/pi/cc02/brain/main.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
